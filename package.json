{
    "name": "@koslibs/api",
    "version": "0.1.6",
    "description": "Reusable API client utilities",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "private": false,
    "license": "MIT",
    "author": "holypower777",
    "type": "module",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "koslibs-builder lib:build",
        "typecheck": "koslibs-builder lib:typecheck",
        "lint": "koslibs-lint lint",
        "lint:fix": "koslibs-lint lint:fix",
        "lint:js": "koslibs-lint js",
        "lint:js:fix": "koslibs-lint js --fix",
        "format": "koslibs-lint format",
        "format:check": "koslibs-lint format:check",
        "pretest": "koslibs-builder lib:build",
        "test": "koslibs-builder lib:test",
        "posttest": "koslibs-builder lib:typecheck --root ./tests",
        "test:types": "koslibs-builder lib:typecheck --root ./tests",
        "prepack": "koslibs-builder lib:build",
        "release": "koslibs-release publish",
        "release:snapshot": "koslibs-release publish --tag snapshot --no-git-tag",
        "version-package": "koslibs-release version",
        "version-package:snapshot": "koslibs-release version --snapshot snapshot",
        "changeset": "koslibs-release add",
        "changeset:check": "koslibs-release check",
        "prepare": "koslibs-release hooks:install"
    },
    "bugs": {
        "url": "https://github.com/koslibs/api/issues"
    },
    "homepage": "https://github.com/koslibs/api",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/koslibs/api.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24.13.0"
    },
    "sideEffects": false,
    "prettier": "./node_modules/@koslibs/configs/prettier",
    "commitlint": {
        "extends": "./node_modules/@koslibs/configs/commitlint"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./axios": {
            "types": "./dist/axios/index.d.ts",
            "import": "./dist/axios/index.js"
        },
        "./create-api": {
            "types": "./dist/create-api/create-api.d.ts",
            "import": "./dist/create-api/create-api.js"
        },
        "./create-api/api-base-path": {
            "types": "./dist/create-api/api-base-path.d.ts",
            "import": "./dist/create-api/api-base-path.js"
        },
        "./use-api": {
            "types": "./dist/use-api/index.d.ts",
            "import": "./dist/use-api/index.js"
        },
        "./package.json": "./package.json"
    },
    "keywords": [
        "api",
        "axios",
        "hooks",
        "react",
        "typescript"
    ],
    "funding": {
        "type": "github",
        "url": "https://github.com/koslibs"
    },
    "typesVersions": {
        "*": {
            "axios": [
                "./dist/axios/index.d.ts"
            ],
            "create-api": [
                "./dist/create-api/create-api.d.ts"
            ],
            "create-api/api-base-path": [
                "./dist/create-api/api-base-path.d.ts"
            ],
            "use-api": [
                "./dist/use-api/index.d.ts"
            ]
        }
    },
    "dependencies": {
        "axios": "1.20.0"
    },
    "devDependencies": {
        "@koslibs/builder": "^0.1.0",
        "@koslibs/configs": "^0.2.12",
        "@types/node": "^24.19.0",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
